{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* scripts/는 tsx로 돌린다(package.json의 sweep:pattern/check:sleeve) —
       tsx는 번들러식으로 해석하므로 tsconfig.node.json의 nodenext가 아니라
       tsconfig.app.json과 같은 bundler 해석을 써야 실제 실행 방식과 맞는다
       ("type": "module" + nodenext면 확장자 없는 상대 임포트가 전부 에러). */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}
