{
  "name": "fit-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": "25.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "tsc -b && vite build && electron-builder",
    "electron:pack": "tsc -b && vite build && electron-builder --dir",
    "check:sleeve": "tsx scripts/checkSleeveSeam.ts",
    "check:seambridge": "tsx scripts/checkSeamBridge.ts",
    "sweep:pattern": "tsx scripts/paramSweep.ts",
    "check:weld": "tsx scripts/checkWeldTopology.ts",
    "capture": "tsx scripts/capture.ts",
    "check:demo": "tsx scripts/checkDemoSmoke.ts",
    "spike:dressing": "tsx scripts/spikeDressing.ts",
    "check:pattern": "tsx scripts/checkPattern.ts",
    "check:outline": "tsx scripts/checkOutline.ts",
    "dress:pattern": "tsx scripts/dressPattern.ts",
    "check:boundary": "tsx scripts/checkBoundary.ts",
    "check:topology": "tsx scripts/checkTopology.ts",
    "report": "tsx scripts/roundReport.ts",
    "v3:s1": "tsx scripts/v3S1.ts",
    "v3:s1ab": "tsx scripts/v3S1ab.ts",
    "v3:s2": "tsx scripts/v3S2.ts",
    "v3:conv": "tsx scripts/v3Conv.ts",
    "v3:s2b": "tsx scripts/v3S2b.ts",
    "v3:def": "tsx scripts/v3Def.ts",
    "v3:lay": "tsx scripts/v3Lay.ts",
    "v3:asp": "tsx scripts/v3Asp.ts",
    "v3:req": "tsx scripts/v3Req.ts",
    "v3:s3": "tsx scripts/v3S3.ts",
    "v3:s3b": "tsx scripts/v3S3b.ts"
  },
  "build": {
    "appId": "com.fitsimulator.app",
    "productName": "Fit Simulator",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dir"
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.10",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10"
  }
}
